{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "go -C \"$CLAUDE_PROJECT_DIR\" run ./tools/fmthook",
            "shell": "bash",
            "timeout": 60,
            "statusMessage": "Formatting Go file"
          }
        ]
      }
    ]
  }
}
